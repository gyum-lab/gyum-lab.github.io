---
layout: default
---
<div class="post qm-about">
  <section class="qm-hero">
    <div class="qm-hero-inner">
      {% if page.profile.image %}
        <img
          class="qm-photo"
          src="{{ page.profile.image | prepend: '/assets/img/' | relative_url | bust_file_cache }}"
          alt="{{ site.first_name }} {{ site.last_name }}"
          loading="eager"
        >
      {% endif %}
      <div class="qm-intro">
        <h1 class="post-title">{{ site.first_name }} {{ site.last_name }}</h1>
        <p class="qm-role">{{ page.subtitle }}</p>
        <div class="qm-bio">{{ content }}</div>
        <p class="qm-links">
          {% if site.data.socials.email %}
            <a href="mailto:{{ site.data.socials.email }}">{{ site.data.socials.email }}</a>
          {% endif %}
          {% if site.data.socials.scholar_userid %}
            <a href="https://scholar.google.com/citations?user={{ site.data.socials.scholar_userid }}">Google Scholar</a>
          {% endif %}
          {% if site.data.socials.linkedin_username %}
            <a href="https://www.linkedin.com/in/{{ site.data.socials.linkedin_username }}">LinkedIn</a>
          {% endif %}
        </p>
      </div>
    </div>
  </section>

  <article>
    {% if page.interests %}
      <h2>Research interests</h2>
      <ul class="qm-interests">
        {% for item in page.interests %}
          <li>{{ item }}</li>
        {% endfor %}
      </ul>
    {% endif %}

    {% if page.news %}
      <hr class="qm-rule">
      <h2>News</h2>
      <ul class="qm-news">
        {% for item in page.news %}
          <li>
            <span class="qm-news-text">{{ item.text | markdownify | remove: '<p>' | remove: '</p>' }}</span>
            <span class="qm-news-date">{{ item.date }}</span>
          </li>
        {% endfor %}
      </ul>
    {% endif %}

    {% if page.selected_papers %}
      <hr class="qm-rule">
      <h2>Selected publications</h2>
      {% include selected_papers.liquid %}
      <p class="qm-more"><a href="{{ '/publications/' | relative_url }}">All publications →</a></p>
    {% endif %}
  </article>
</div>
